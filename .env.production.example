# Production Environment Configuration for Flownest CMS

# Application
APP_NAME=Flownest
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Maintenance
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (Docker MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flownest
DB_USERNAME=flownest
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Session & Cache (Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=flownest_cache

# Redis (Docker)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# AWS S3 (Optional - for media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DigitalOcean Spaces (Optional - S3-compatible storage)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_URL=https://your-bucket.nyc3.digitaloceanspaces.com

# Media Storage Configuration
# Options: public (local), s3, spaces
MEDIA_DISK_DRIVER=public
MEDIA_URL=

# Meilisearch (Docker)
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=CHANGE_ME_MASTER_KEY
MEILISEARCH_NO_ANALYTICS=true

# Laravel Pulse - Application Monitoring
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=database
PULSE_STORE_DRIVER=redis
PULSE_REDIS_CONNECTION=cache

# Pulse Recorders Configuration
PULSE_CACHE_INTERACTIONS_ENABLED=true
PULSE_EXCEPTIONS_ENABLED=true
PULSE_QUEUES_ENABLED=true
PULSE_SLOW_JOBS_ENABLED=true
PULSE_SLOW_JOBS_THRESHOLD=1000
PULSE_SLOW_QUERIES_ENABLED=true
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_SLOW_REQUESTS_ENABLED=true
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_OUTGOING_REQUESTS_ENABLED=true
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000
PULSE_USER_JOBS_ENABLED=true
PULSE_USER_REQUESTS_ENABLED=true

# Sentry - Error Tracking (Optional but recommended)
SENTRY_LARAVEL_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# Docker Configuration
APP_PORT=80
APP_SSL_PORT=443

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_SOURCEMAP=false

# Response Cache
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=redis

# Security
# Uncomment and configure if using in production
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=yourdomain.com
